# ============================================================================
#  Scoopt frontend — environment variables
# ----------------------------------------------------------------------------
#  Copy this file to `.env.local` for local development and fill in the values.
#  In production, set the SAME variables in the Vercel project's
#  Settings -> Environment Variables. Never commit real values (.env* is
#  gitignored).
# ============================================================================

# --- Backend API (server-side only; no NEXT_PUBLIC_ prefix) ------------------
# The address of Larry's backend (the contract-server). The Next.js /api/*
# routes proxy to it. In the browser the frontend always calls the relative
# "/api/..." path, so this is never shipped to the client.
#   Local dev:   http://localhost:3002
#   Production:  https://<your-backend-host>   (e.g. a Railway URL)
BACKEND_URL=http://localhost:3002

# --- Supabase Auth (safe to expose; these are public by design) --------------
# Without these, the site still runs but sign-in/sign-up is disabled and shows
# a clear message (it no longer crashes every page). Find them in the Supabase
# dashboard under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Catalogue cache clearing (server-side only) ------------------------------
# Shared secret for POST /api/revalidate, which clears the cached catalogue.
# The backend's ingest job and nightly refresh job send it. Set the SAME value
# as REVALIDATE_SECRET on the Railway services. Generate one with e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, /api/revalidate refuses every call (and the 6-hour backstop in
# lib/catalogCache.ts is the only thing that refreshes the site).
REVALIDATE_SECRET=
