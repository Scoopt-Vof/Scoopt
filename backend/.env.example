# Copy this file to `.env` and fill it in. Never commit `.env`.

# Supabase → Settings → Database → Connection string → URI
# Use the SESSION pooler (port 5432) for ingestion. The TRANSACTION pooler
# (port 6543) also works for the API; prepared statements are switched off
# automatically for it (src/lib/db.ts).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Local Postgres instead, if you'd rather not touch Supabase yet:
# DATABASE_URL=postgresql://postgres@localhost:5432/scoopt

PG_POOL_MAX=5


# ─── API server (npm run serve / npm start) ─────────────────────────────

# Listen port for `npm run serve`. `npm start` uses the host's PORT instead.
CONTRACT_PORT=3002

# Browser origins allowed to call the API directly. Production traffic goes
# through the Next.js proxy (server-to-server) and needs none. `*` allows all.
CORS_ORIGINS=http://localhost:3000

# Requests per minute per client IP; 0 disables. See src/contract-server.ts
# before lowering it: behind the Next.js proxy all shoppers share one IP.
RATE_LIMIT_PER_MINUTE=600
# TRUST_PROXY=1

# Set to enable GET /health/details (send header x-health-token: <value>).
HEALTH_TOKEN=

# Offers not refreshed by an ingest run within this many hours are hidden.
OFFER_MAX_AGE_HOURS=48

# How many feed rows the ingest processes at once. The bottleneck is database
# round-trips, so this is the main speed dial for a big feed like GSM Net.
# Keep it at or below PG_POOL_MAX; set to 1 for the old sequential behaviour.
INGEST_CONCURRENCY=5


# ─── Live retailer APIs ─── see README-LIVE-APIS.md for signup steps ───

# eBay — developer.ebay.com → Application Keys (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MAX_ITEMS_PER_QUERY=8
# Do NOT set EBAY_QUERIES unless you mean it: it replaces the built-in,
# category-tagged search list in src/sources/ebay.ts and tags every result as
# sport/running.

# eBay Partner Network campaign id. When set, stored links are affiliate
# links (itemAffiliateWebUrl) so click-outs can earn commission.
EPN_CAMPAIGN_ID=

# ─── Awin affiliate product feeds ─── see README-AWIN.md ───────────────
# GSM Net (telecom/phones). Awin → Toolbox → Create-a-Feed → GSM Net → CSV,
# gzip → copy the generated feed URL here. The feed's aw_deep_link is the
# tracked, commission-bearing click-out. Run with: npm run ingest -- gsm-net
GSMNET_FEED_URL=
# Optional overrides (defaults are fine):
# GSMNET_CATEGORY=tech            # contract category seed before classification
# GSMNET_FEED_DELIMITER=,         # force the CSV delimiter if auto-detect misfires

# The three below were applied for on Awin in 2026-09 and are awaiting advertiser
# approval. The adapters already exist (src/sources/*.ts) and are registered. Once
# a programme is approved: Create-a-Feed (same columns as GSM Net) → paste the URL
# here and in Railway → append the slug to package.json `ingest:railway` → run
# `npm run ingest -- <slug>`. Leave blank until then.
#
# JD Sports NL (sportswear/trainers). Run with: npm run ingest -- jd-sports
JDSPORTS_FEED_URL=
# Knivesandtools NL (knives/tools/outdoor/kitchen). Run: npm run ingest -- knivesandtools
KNIVESANDTOOLS_FEED_URL=
# Bruno Bed NL (beds/mattresses/home). Run with: npm run ingest -- bruno-bed
BRUNOBED_FEED_URL=

# Icecat — icecat.biz (MyIcecat -> Access details -> Manage Access Tokens).
# Not a retailer feed: enriches existing products with image/description/
# specs. See README-ICECAT.md. Run with: npm run enrich:icecat
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=

# Sent on every outbound request. Put a real contact address here.
HTTP_USER_AGENT=Scoopt/0.1 (price comparison; +https://scoopt.nl; contact@scoopt.nl)

# Where ingest archives raw payloads. Defaults to ./raw — point it at
# persistent storage when ingest runs on a host with a throwaway disk.
# RAW_ARCHIVE_DIR=

# --- Tests --------------------------------------------------------------
# The test suite TRUNCATES every table, so this must be a throwaway database:
# never the same one as DATABASE_URL, and never your live Supabase project.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/scoopt_test

# --- Website cache clearing -----------------------------------------------
# Ingest tells the website to drop its cached
# catalogue once new prices are in. Set these on the Railway service that runs
# `npm run ingest:railway`.
# SITE_URL=https://scoopt.nl
# REVALIDATE_SECRET=        # same value as REVALIDATE_SECRET in Vercel

# --- Price history -----------------------------------------------------------
# History rows are written only when a price/shipping/stock changes (db/015).
# An unchanged offer still gets a new row after this many hours unseen, so a
# gap shows in the chart. Must be longer than the time between ingest runs:
# 26 suits the daily run; set 3 once ingest runs hourly.
# PRICE_GAP_HOURS=26

# --- Hourly ingest ------------------------------------------------------------
# Unchanged feed rows only get last_seen_at moved; only changed products are
# cleared on the website. Above this many changed product ids one full clear is
# sent instead of a targeted one.
# TARGETED_CLEAR_MAX=500
# Exit with an error (so Railway notifies) from this many failed runs in a row.
# A run where every source fails always alerts.
# ALERT_AFTER_FAILURES=2
# A "running" mark older than this (minutes) is from a crashed run and ignored.
# JOB_STALE_MINUTES=50
