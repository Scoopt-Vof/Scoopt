{
  "name": "scoopt-backend-trial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoopt back end \u2014 ingestion, API and data quality. Prices come from eBay; Icecat enriches them.",
  "scripts": {
    "start": "tsx src/server.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "ingest": "tsx --env-file=.env src/ingest/run.ts",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ingest:list": "tsx --env-file=.env src/ingest/run.ts --list",
    "ingest:all": "tsx --env-file=.env src/ingest/run.ts all",
    "enrich:icecat": "tsx --env-file=.env src/ingest/enrich-icecat.ts",
    "icecat:categories": "tsx --env-file=.env src/ingest/list-icecat-categories.ts",
    "discover:icecat": "tsx --env-file=.env src/ingest/discover-icecat.ts",
    "serve": "tsx --env-file=.env src/contract-server.ts",
    "trial": "npm run db:migrate && npm run serve",
    "backfill:categories": "tsx --env-file=.env scripts/backfill-categories.ts"
  },
  "dependencies": {
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
